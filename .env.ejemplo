# Copie este archivo como .env y complete los valores. El .env real no se sube a GitHub.

# Base de datos MariaDB
DB_NAME=claudia_spa
DB_USER=claudia_spa
DB_PASSWORD=cambie-esta-contraseña
DB_HOST=localhost
DB_PORT=3306

# Django
SECRET_KEY=genere-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Cuenta de administrador de prueba (solo desarrollo local)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@claudiaspa.local
DJANGO_SUPERUSER_PASSWORD=cambie-esta-contraseña
